@model CustomerSearchViewModel
@* 【E2 新增】共用组件：客户搜索部分视图（房源页和预约页都用）
   表单提交到哪里、选中客户后跳到哪里，都由 Model 里的 FormController/FormAction/SelectController/SelectAction 决定 *@

<div class="agent-form-card mb-4">
    <div class="agent-info">Search Customer</div>

    <form asp-controller="@Model.FormController" asp-action="@Model.FormAction" method="get">
        @* 标记"点了搜索"，控制器据此决定要不要执行搜索 *@
        <input type="hidden" name="Searched" value="true" />

        @* 搜索条件无效或不完整时，在这里显示错误 *@
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row mb-3">
            <div class="col-md-3 mb-3 mb-md-0">
                <label asp-for="FirstName" class="form-label agent-label">First Name</label>
                <input asp-for="FirstName" class="form-control agent-input" />
            </div>
            <div class="col-md-3 mb-3 mb-md-0">
                <label asp-for="LastName" class="form-label agent-label">Last Name</label>
                <input asp-for="LastName" class="form-control agent-input" />
            </div>
            <div class="col-md-3 mb-3 mb-md-0">
                <label asp-for="Phone" class="form-label agent-label">Phone Number</label>
                <input asp-for="Phone" class="form-control agent-input" />
            </div>
            <div class="col-md-3">
                <label asp-for="CustomerId" class="form-label agent-label">Customer ID</label>
                <input asp-for="CustomerId" class="form-control agent-input" />
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a asp-controller="Customers" asp-action="Create" class="small">Customer not in the system? Create Customer</a>
            <button type="submit" class="btn create-btn btn-inline">Search</button>
        </div>
    </form>
</div>

@* 搜索结果：只有点过搜索且条件有效时才显示 *@
@if (Model.Searched && ViewData.ModelState.IsValid)
{
    if (Model.Results.Count == 0)
    {
        @* 无结果：提示并让用户重试，同时提示可以先去创建客户 *@
        <div class="alert alert-warning">
            No matching customers were found. Please try again, or
            <a asp-controller="Customers" asp-action="Create">create the customer</a> first.
        </div>
    }
    else
    {
        <div class="e2-section-title mt-0">Matching Customers (@Model.Results.Count)</div>
        <div class="table-responsive">
            <table class="e2-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Municipality</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Results)
                    {
                        <tr>
                            <td>@customer.ID</td>
                            <td>@customer.FirstName @customer.MiddleName @customer.LastName</td>
                            <td>@customer.Phone</td>
                            <td>@customer.Email</td>
                            <td>@customer.Municipality</td>
                            <td class="text-end">
                                <a asp-controller="@Model.SelectController"
                                   asp-action="@Model.SelectAction"
                                   asp-route-customerId="@customer.ID"
                                   class="btn create-btn btn-inline">Select</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
