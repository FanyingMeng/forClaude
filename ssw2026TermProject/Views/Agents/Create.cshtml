@model ssw2026TermProject.Models.Agent;

@{
    ViewData["Title"] = "Create Agent";
}

<div class="bg-color py-4">
    <div class="container" style="max-width: 900px;">

        
        <h2 class="create-agent mb-4 text-uppercase">CREATE AGENT</h2>

        
        <div class="agent-form-card">

            <div class="agent-info">
                Agent Information
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                
                <div class="row mb-3">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="FirstName" class="form-label agent-label">First Name</label>
                        <input asp-for="FirstName" class="form-control agent-input" />
                        <span asp-validation-for="FirstName" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="MiddleName" class="form-label agent-label">Middle Name (Optional)</label>
                        <input asp-for="MiddleName" class="form-control agent-input" />
                        <span asp-validation-for="MiddleName" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LastName" class="form-label agent-label">Last Name</label>
                        <input asp-for="LastName" class="form-control agent-input" />
                        <span asp-validation-for="LastName" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                
                <div class="row mb-3">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="Username" class="form-label agent-label">Username</label>
                        <input asp-for="Username" class="form-control agent-input" />
                        <span asp-validation-for="Username" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="SIN" class="form-label agent-label">SIN</label>
                        <input asp-for="SIN" class="form-control agent-input" />
                        <span asp-validation-for="SIN" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DateOfBirth" class="form-label agent-label">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control agent-input" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                
                <div class="row mb-3">
                    <div class="col-12">
                        <label asp-for="StreetAddress" class="form-label agent-label">Street Address</label>
                        <input asp-for="StreetAddress" class="form-control agent-input" />
                        <span asp-validation-for="StreetAddress" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                
                <div class="row mb-3">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="City" class="form-label agent-label">City</label>
                        <input asp-for="City" class="form-control agent-input" />
                        <span asp-validation-for="City" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="Province" class="form-label agent-label">Province</label>
                        <input asp-for="Province" class="form-control agent-input" />
                        <span asp-validation-for="Province" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PostalCode" class="form-label agent-label">Postal Code</label>
                        <input asp-for="PostalCode" class="form-control agent-input" />
                        <span asp-validation-for="PostalCode" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                
                <div class="row mb-3">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="MobilePhone" class="form-label agent-label">Mobile Phone</label>
                        <input asp-for="MobilePhone" class="form-control agent-input" />
                        <span asp-validation-for="MobilePhone" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="OfficePhone" class="form-label agent-label">Office Phone</label>
                        <input asp-for="OfficePhone" class="form-control agent-input" />
                        <span asp-validation-for="OfficePhone" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="HomePhone" class="form-label agent-label">Home Phone</label>
                        <input asp-for="HomePhone" class="form-control agent-input" />
                        <span asp-validation-for="HomePhone" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                
                <div class="row mb-4">
                    <div class="col-12">
                        <label asp-for="Email" class="form-label agent-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control agent-input" />
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
                
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="HasVerifiedGovernmentId"
                                   class="form-check-input" />

                            <label asp-for="HasVerifiedGovernmentId"
                                   class="form-check-label">
                                I confirm that I have verified the government-issued ID.
                            </label>
                        </div>

                        <span asp-validation-for="HasVerifiedGovernmentId"
                              class="text-danger small">
                        </span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a asp-action="Index" class="btn cancel-btn text-decoration-none text-center">
                        Cancel
                    </a>
                    <button type="submit" class="btn create-btn">
                        Create Agent
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
